<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Appops, not runtime: requestPermissions() does nothing for this one.
         Granted by sending the user to Settings.ACTION_USAGE_ACCESS_SETTINGS. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Optional and never required: offered in the app so the sync schedule
         survives the RARE standby bucket, where the quota is three job
         sessions a day. Play policy forbids asking for this; sideloaded, only
         the technical merit applies, and it beats a foreground service. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Sideloaded apps have no store to update them, so the app updates
         itself. This is signature|appop: it cannot be requested at runtime,
         only toggled in Settings, which is what canRequestPackageInstalls()
         reports and MainActivity deep-links to. Even granted, the install
         itself still shows the system confirmation dialog — one tap per
         update is the floor for an unprivileged app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The update prompt is a notification, and from API 33 that needs an
         explicit grant. Sync keeps working without it; the settings screen is
         then the only place an update shows up. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- To resolve a package name to a human-readable app label. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- The sync loop lives in a foreground service (SyncService) because
         WorkManager alone proved mortal: a stopped-state app has its jobs
         cancelled and nothing left to re-arm them, which cost a week of data.
         specialUse rather than dataSync — no runtime cap, no ban on
         BOOT_COMPLETED starts. FOREGROUND_SERVICE would be merged in by
         WorkManager anyway; declared explicitly so the dependency is visible.
         Still deliberately absent: SCHEDULE_EXACT_ALARM — nothing here needs
         to fire at an exact moment, UsageStatsManager is retrospective. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- A self-hosted server on the LAN is usually plain HTTP with no
         certificate to speak of, and refusing to talk to it would make the
         common case unconfigurable. -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The package installer runs in another process and cannot read our
             cache directory, so the downloaded APK is handed over as a content
             URI with a read grant rather than a file path. The authority is
             derived from the applicationId so the debug variant, which carries
             a .debug suffix, does not collide with a release build installed
             alongside it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The always-on sync leg. specialUse needs its purpose declared as a
             property; there is no reviewer off-Play, but the declaration is
             what exempts the service from the dataSync-style runtime caps. -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="continuous personal usage-stats collection posted to the owner's private LAN server" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
